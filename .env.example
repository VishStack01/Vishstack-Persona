# Copy to .env and fill in what you use. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Search (one of these)
BRAVE_API_KEY=
TAVILY_API_KEY=

# YouTube Data API v3 key (Google Cloud console)
YOUTUBE_API_KEY=

# Meta Ad Library API (identity-confirmed Meta account) and your Instagram (Instagram API with Instagram Login)
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
INSTAGRAM_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

# Local transcription model size for faster-whisper: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# Protects your API bill: the app stops calling models after this many calls in 24 hours
VSP_MAX_CALLS_PER_DAY=400

# Required if the app is reachable from anything other than your own machine (any username, this password)
APP_PASSWORD=
